# HTTP
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://nghenhac:nghenhac@127.0.0.1:5433/nghenhac

# JWT access tokens. Use a long random secret in any deployed environment.
JWT_ISSUER=https://nghenhacpromax.local
JWT_AUDIENCE=nghenhacpromax-web
JWT_SECRET=replace-with-at-least-32-chars-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Refresh cookie
COOKIE_NAME=nnpm_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
COOKIE_PATH=/v1/auth
TRUST_PROXY_HOPS=0

# CORS allowlist (comma-separated). Never use * with credentials.
# Include the Vite origin (default http://localhost:1420) so cookie auth works.
# The same list is applied to object-storage CORS by npm run server:ensure-storage.
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://localhost:5173,http://127.0.0.1:5173,http://tauri.localhost,https://tauri.localhost

# Catalog reads require a valid access token unless this is true.
# Streaming always requires authentication.
CATALOG_PUBLIC=false

# Auth rate limit (register / login / refresh)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# S3-compatible object storage (MinIO locally)
S3_ENDPOINT=http://127.0.0.1:9000
# Host/browser-facing endpoint used when signing URLs. Inside Compose this is
# typically the published host port, not the Docker DNS name.
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=nghenhacpromax
S3_ARTWORK_BUCKET=nghenhacpromax-artwork
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# aws always requires PutBucketCors. minio skips only the unsupported per-bucket CORS API.
S3_COMPATIBILITY=minio
SIGNED_URL_TTL_SECONDS=180
PUBLIC_MEDIA_BASE_URL=http://127.0.0.1:9000/nghenhacpromax-artwork
UPLOAD_MAX_AUDIO_BYTES=1073741824
UPLOAD_MAX_ARTWORK_BYTES=20000000
PRESIGN_PUT_TTL_SECONDS=900
NNPM_PROBE_PATH=nnpm-probe
NNPM_PROBE_STARTUP_TIMEOUT_MS=5000
MEDIA_PROBE_MODE=nnpm
WORKER_POLL_MS=1500
WORKER_LEASE_SECONDS=120
WORKER_ONCE_BATCH_SIZE=8
WORKER_TEMP_DIR=
WORKER_HEARTBEAT_PATH=
METRICS_ENABLED=false
METRICS_TOKEN=
DATABASE_PING_TIMEOUT_MS=2000
INTEGRATION_TESTS_REQUIRED=false
S3_INTEGRATION_REQUIRED=false
NNPM_PROBE_REQUIRED=false
ALLOWED_AUDIO_MIMES=audio/flac,audio/x-flac,audio/wav,audio/wave,audio/x-wav,audio/mpeg,audio/mp3,audio/mp4,audio/aac,audio/x-m4a,audio/ogg,audio/webm,audio/opus,audio/dsf,audio/x-dsf,audio/dff,audio/x-dff,application/x-dff
ALLOWED_ARTWORK_MIMES=image/jpeg,image/png,image/webp,image/avif
ARTWORK_MAX_PIXELS=40000000
ARTWORK_REQUIRED_FOR_PUBLISH=false

# Ready-check storage timeout
STORAGE_PING_TIMEOUT_MS=2000

# Lyrics provider (fixed origin — never taken from client input)
LYRICS_PROVIDER_URL=https://lrclib.net
LYRICS_PROVIDER_TIMEOUT_MS=4000
LYRICS_PROVIDER_MAX_BYTES=262144
LYRICS_POSITIVE_TTL_SECONDS=604800
LYRICS_NEGATIVE_TTL_SECONDS=3600
# Empty uses the ingestion/audio/ default. Never leave this blank in production —
# an empty allowlist is rejected and the whole bucket is not scanned.
IMPORT_RECONCILE_PREFIXES=ingestion/audio/
IMPORT_RECONCILE_MAX_OBJECTS=200
STREAM_RATE_LIMIT_MAX=120
ADMIN_RATE_LIMIT_MAX=30
# OpenAPI UI. Defaults to off when NODE_ENV=production.
DOCS_ENABLED=
