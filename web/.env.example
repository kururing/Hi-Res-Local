# Keep "mock" for the existing browser preview. Set "web" to enable the cloud
# account gate against the local API. Tauri runtime detection always takes
# precedence.
VITE_APP_RUNTIME=mock
VITE_CLOUD_API_URL=/api

# Vite dev-server proxy target for /api. Not used in production builds.
VITE_CLOUD_API_PROXY_TARGET=http://127.0.0.1:3001
